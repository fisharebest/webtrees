parameters:
    fileExtensions:
        - php
        - phtml

    level: 6

    #checkUninitializedProperties: true
    #checkImplicitMixed: true
    #checkBenevolentUnionTypes: true

    paths:
        - index.php
        - public/index.php
        - app
        - resources/views
        - tests

    dynamicConstantNames:
        - Fisharebest\Webtrees\Webtrees::STABILITY
