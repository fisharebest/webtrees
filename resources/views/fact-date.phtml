<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Age;
use Fisharebest\Webtrees\Date;
use Fisharebest\Webtrees\Enums\Sex;
use Fisharebest\Webtrees\Fact;
use Fisharebest\Webtrees\Family;
use Fisharebest\Webtrees\Gedcom;
use Fisharebest\Webtrees\GedcomRecord;
use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Individual;
use Fisharebest\Webtrees\Registry;

/**
 * @var bool         $cal_link
 * @var Fact         $fact
 * @var GedcomRecord $record
 * @var bool         $time
 */

$factrec = $fact->gedcom();
$html    = '';

// Recorded age (raw GEDCOM values and display-formatted values)
if (preg_match('/\n2 AGE (.+)/', $factrec, $match) === 1) {
    $raw_fact_age = $match[1];
    $fact_age     = Registry::elementFactory()->make($fact->tag() . ':AGE')->value($match[1], $record->tree());
} else {
    $raw_fact_age = '';
    $fact_age     = '';
}

if (preg_match('/\n2 HUSB\n3 AGE (.+)/', $factrec, $match) === 1) {
    $raw_husb_age = $match[1];
    $husb_age     = Registry::elementFactory()->make($fact->tag() . ':HUSB:AGE')->value($match[1], $record->tree());
} else {
    $raw_husb_age = '';
    $husb_age     = '';
}

if (preg_match('/\n2 WIFE\n3 AGE (.+)/', $factrec, $match) === 1) {
    $raw_wife_age = $match[1];
    $wife_age     = Registry::elementFactory()->make($fact->tag() . ':WIFE:AGE')->value($match[1], $record->tree());
} else {
    $raw_wife_age = '';
    $wife_age     = '';
}

// Calculated age
[, $tag] = explode(':', $fact->tag());

if (preg_match('/\n2 DATE (.+)/', $factrec, $match) === 1) {
    $date = new Date($match[1]);
    $html .= ' ' . $date->display($cal_link ? $record->tree() : null, null, true);
    // Time isn't valid GEDCOM, but it is widely used.
    if ($time && preg_match('/\n3 TIME (.+)/', $factrec, $match) === 1) {
        $html .= ' – <span class="date">' . $match[1] . '</span>';
    }

    if ($record instanceof Individual) {
        if (
            in_array($tag, Gedcom::BIRTH_EVENTS, true) &&
            $record === $fact->record() &&
            $record->tree()->getPreference('SHOW_PARENTS_AGE') === '1'
        ) {
            // age of parents at child's birth
            $html .= view('fact-parents-age', ['individual' => $record, 'birth_date' => $date]);
        }

        if ($tag !== 'BIRT') {
            // age at event
            $birth_date = $record->getBirthDate();
            // Can't use getDeathDate(), as this also gives BURI/CREM events, which
            // wouldn't give the correct "days after death" result for people with
            // no DEAT.
            $death_event = $record->facts(['DEAT'])->first();
            if ($death_event instanceof Fact) {
                $death_date = $death_event->date();
            } else {
                $death_date = new Date('');
            }
            $age_text = '';

            if ($tag === 'DEAT' || Date::compare($date, $death_date) <= 0 || !$record->isDead()) {
                // Before death, print age
                $age = new Age($birth_date, $date);

                if ($age->isValid()) {
                    // Determine the relevant raw recorded age for comparison
                    $spouse_raw_age = $raw_fact_age;
                    if ($spouse_raw_age === '' && $raw_husb_age !== '' && $record->sex() === Sex::Male) {
                        $spouse_raw_age = $raw_husb_age;
                    } elseif ($spouse_raw_age === '' && $raw_wife_age !== '' && $record->sex() === Sex::Female) {
                        $spouse_raw_age = $raw_wife_age;
                    }

                    // Show calculated age unless it matches the recorded age
                    if (!$age->matchesRecordedAge($spouse_raw_age) && !$age->isZero()) {
                        $age_text = match ($record->sex()) {
                            Sex::Male   => I18N::translateContext('Male', '(aged %s)', $age->toString()),
                            Sex::Female => I18N::translateContext('Female', '(aged %s)', $age->toString()),
                            default     => I18N::translate('(aged %s)', $age->toString()),
                        };
                    }
                }
            }

            if ($tag !== 'DEAT' && $death_date->isOK() && Date::compare($death_date, $date) <= 0) {
                $afterDeathAge = new Age($death_date, $date);

                if ($afterDeathAge->isZero()) {
                    // On the exact date of death
                    $age_text = I18N::translate('(on the date of death)');
                } elseif ($afterDeathAge->isValid()) {
                    // After death
                    $age_string = $afterDeathAge->toString();

                    if ($age_string !== '') {
                        $age_text = I18N::translate('(%s after death)', $age_string);
                    } else {
                        $age_text = '';
                    }
                }

                // Family events which occur after death are probably errors
                if ($fact->record() instanceof Family && $age_text !== '') {
                    $age_text .= view('icons/warning');
                }
            }

            if ($age_text !== '') {
                $html .= ' <span class="age">' . $age_text . '</span>';
            }
        }
    } elseif ($record instanceof Family) {
        // Calculate ages of both spouses at family events
        $spouses = [
            'husb' => $record->husband(),
            'wife' => $record->wife(),
        ];

        foreach ($spouses as $role => $spouse) {
            if (!$spouse instanceof Individual) {
                continue;
            }

            $recorded_age     = $role === 'husb' ? $husb_age : $wife_age;
            $raw_recorded_age = $role === 'husb' ? $raw_husb_age : $raw_wife_age;
            $birth_date       = $spouse->getBirthDate();
            $death_event      = $spouse->facts(['DEAT'])->first();
            $death_date       = $death_event instanceof Fact ? $death_event->date() : new Date('');

            if (Date::compare($date, $death_date) <= 0 || !$spouse->isDead()) {
                // Event before death — calculate age at event
                $age = new Age($birth_date, $date);

                if ($age->isValid() && !$age->matchesRecordedAge($raw_recorded_age)) {
                    $age_string = $age->toString();

                    if ($age_string !== '') {
                        if ($recorded_age !== '') {
                            // Recorded age differs from calculated — show both to highlight potential error
                            $age_text = $recorded_age . ' ' . match ($spouse->sex()) {
                                Sex::Male   => I18N::translateContext('Male', '(aged %s)', $age_string),
                                Sex::Female => I18N::translateContext('Female', '(aged %s)', $age_string),
                                default     => I18N::translate('(aged %s)', $age_string),
                            };
                        } else {
                            // No recorded age — show calculated
                            $age_text = $age_string;
                        }

                        if ($role === 'husb') {
                            $husb_age = $age_text;
                        } else {
                            $wife_age = $age_text;
                        }
                    }
                }
            } elseif ($death_date->isOK()) {
                // Event after death — probably an error
                $age = new Age($death_date, $date);
                $age_string = $age->toString();

                if ($age_string !== '') {
                    $after_death = I18N::translate('%s after death', $age_string) . ' ' . view('icons/warning');

                    if ($role === 'husb') {
                        $husb_age = $husb_age !== '' ? $husb_age . ' ' . $after_death : $after_death;
                    } else {
                        $wife_age = $wife_age !== '' ? $wife_age . ' ' . $after_death : $after_death;
                    }
                }
            }
        }
    }
}
// Determine appropriate labels for spouse ages based on actual sex
$record = $fact->record();

if ($record instanceof Family) {
    $husb_label = match($record->husband()?->sex()) {
        Sex::Male => I18N::translate('Husband'),
        Sex::Female => I18N::translate('Wife'),
        default => I18N::translate('Spouse'),
    };

    $wife_label = match($record->wife()?->sex()) {
        Sex::Male => I18N::translate('Husband'),
        Sex::Female => I18N::translate('Wife'),
        default => I18N::translate('Spouse'),
    };
} else {
    $husb_label = I18N::translate('Husband');
    $wife_label = I18N::translate('Wife');
}

$age_labels = [
    I18N::translate('Age') => $fact_age,
    $husb_label            => $husb_age,
    $wife_label            => $wife_age,
];

foreach (array_filter($age_labels, static fn (string $age): bool => $age !== '') as $label => $age) {
    $html .= ' <span class="label">' . $label . ':</span> <span class="age">' . $age . '</span>';
}

?>
<span class="wt-fact-date-age">
    <?= $html ?>
</span>
