            <div class="col-sm-9">
                <div class="input-group" dir="ltr">
                    <span class="input-group-text"><?= e((string) realpath(Webtrees::ROOT_DIR)) ?>/data/</span>
                    <input class="form-control" id="dbcert" name="dbcert" type="text" value="<?= e($dbcert) ?>">
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <label class="form-check-label col-sm-3" for="dbverify">
