            </label>
            <div class="col-sm-9">
                <div class="form-check">
                    <input class="form-check-input" id="dbverify" name="dbverify" type="checkbox" value="1" <?= $dbverify !== '' ? 'checked' : '' ?>>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-form-label col-sm-3" for="dbca">
                <?= I18N::translate('SSL certificate authority') ?>
            </label>
            <div class="col-sm-9">
                <div class="input-group" dir="ltr">
                    <span class="input-group-text"><?= e((string) realpath(Webtrees::ROOT_DIR)) ?>/data/</span>
                    <input class="form-control" id="dbca" name="dbca" type="text" value="<?= e($dbca) ?>">
                </div>
            </div>
