<script>
    document.addEventListener('DOMContentLoaded', function () {
        const select = document.getElementById('jurisdiction');
        const checkboxes = document.querySelectorAll('.statement-checkbox');

        function updateFieldsVisibility(checkbox) {
            const fieldsDiv = document.querySelector('[data-fields-for="' + checkbox.dataset.key + '"]');
            if (fieldsDiv) {
                fieldsDiv.style.display = checkbox.checked ? '' : 'none';
                fieldsDiv.querySelectorAll('.conditional-required').forEach(function (input) {
                    input.required = checkbox.checked;
                });
            }
        }

        checkboxes.forEach(function (cb) {
            updateFieldsVisibility(cb);
            cb.addEventListener('change', function () {
                updateFieldsVisibility(cb);
            });
        });

        select.addEventListener('change', function () {
            const option = select.options[select.selectedIndex];
            const required = (option.dataset.statements || '').split(',').filter(Boolean);

            checkboxes.forEach(function (cb) {
                cb.checked = required.includes(cb.dataset.key);
                updateFieldsVisibility(cb);
            });
        });
    });
</script>
